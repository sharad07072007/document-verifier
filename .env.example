# Copy this file to .env and adjust as needed.

# Database — SQLite by default; swap for Postgres in production, e.g.:
# SCRUTINY_DATABASE_URL=postgresql://user:password@localhost:5432/scrutiny
SCRUTINY_DATABASE_URL=sqlite:///./storage/scrutiny.db

# Uploads
SCRUTINY_MAX_UPLOAD_MB=20
SCRUTINY_RETAIN_UPLOADED_FILES=false

# OCR — only needed if tesseract isn't on your PATH
# SCRUTINY_TESSERACT_CMD=/usr/bin/tesseract

# Deep model — leave unset to skip the deep-learning signal entirely
# SCRUTINY_FORGERY_MODEL_CHECKPOINT=/path/to/checkpoint.pt
SCRUTINY_ENABLE_DEEP_MODEL=true

# CORS — restrict this to your frontend's origin in production
SCRUTINY_ALLOWED_ORIGINS=["*"]
